# System
INSTANCE_ID=brain-instance-001
DEPLOYMENT_NAME=dev
ENVIRONMENT=development

# Database
DATABASE_PATH=./workspace/db/brain.db
DATABASE_BUSY_TIMEOUT=30
DATABASE_JOURNAL_MODE=WAL
DATABASE_FOREIGN_KEYS=true

# Workspace
WORKSPACE_ROOT=./workspace
WORKSPACE_CONFIG_DIR=config
WORKSPACE_DB_DIR=db
WORKSPACE_MISSIONS_DIR=missions
WORKSPACE_LOGS_DIR=logs
WORKSPACE_TMP_DIR=tmp

# Logging
LOG_LEVEL=INFO
LOG_FILE=./workspace/logs/brain.log
LOG_STRUCTURED=false

# Recovery
RECOVERY_AUTO_RECOVER=true
RECOVERY_RECOVERABLE_PHASES=EXECUTE,VALIDATE,REPAIR,WAITING_FOR_APPROVAL
RECOVERY_ORPHAN_DETECTION_GRACE_PERIOD_SECONDS=300

# Concurrency
CONCURRENCY_MAX_ACTIVE_MISSIONS=10
CONCURRENCY_HEARTBEAT_INTERVAL_SECONDS=30

# Mission Defaults
MISSION_DEFAULTS_PRIORITY=MEDIUM
MISSION_DEFAULTS_RISK_LEVEL=LOW
MISSION_DEFAULTS_MAX_LOOP_ITERATIONS=10
# Software-company agent workflow (configure only in local environment / secret store)
BRAIN_AI_BASE_URL=https://api.openai.com/v1
BRAIN_AI_MODEL=
# Set BRAIN_AI_API_KEY outside the repository; never commit a real key.
BRAIN_GITHUB_OWNER=
BRAIN_CONTROL_REPOSITORY=
# Configure BRAIN_GITHUB_TOKEN only in your private environment or secret store.
BRAIN_CONTROL_API_KEY=

# Internal browser worker. Keep the allowlist as narrow as each task allows.
# Example for ChatGPT: chatgpt.com,*.chatgpt.com,openai.com,*.openai.com
BRAIN_BROWSER_ALLOWED_DOMAINS=
BRAIN_BROWSER_PROFILE_DIR=./workspace/browser-profile
BRAIN_BROWSER_HEADLESS=true
# Optional: set only when the selected host has a compatible installed Chromium binary.
BRAIN_BROWSER_EXECUTABLE_PATH=
# Use a long random secret (at least 24 characters); never commit a real value.
