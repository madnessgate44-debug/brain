# System
SYSTEM__INSTANCE_ID=brain-instance-001
SYSTEM__DEPLOYMENT_NAME=dev
SYSTEM__ENVIRONMENT=development

# Database (nested Pydantic settings use double underscores)
DATABASE__SQLITE_PATH=./workspace/db/brain.db
DATABASE__BUSY_TIMEOUT=30
DATABASE__JOURNAL_MODE=WAL
DATABASE__FOREIGN_KEYS=true

# Workspace
WORKSPACE__ROOT=./workspace
WORKSPACE__CONFIG_DIR=config
WORKSPACE__DB_DIR=db
WORKSPACE__MISSIONS_DIR=missions
WORKSPACE__LOGS_DIR=logs
WORKSPACE__TMP_DIR=tmp

# Logging
LOGGING__LOG_LEVEL=INFO
LOGGING__LOG_FILE=./workspace/logs/brain.log
LOGGING__STRUCTURED=false

# Startup recovery normalizes interrupted RUNNING missions; it does not auto-resume them.
RECOVERY__AUTO_RECOVER=true
RECOVERY__RECOVERABLE_PHASES=["EXECUTE","VALIDATE","REPAIR","WAITING_FOR_APPROVAL"]

# Mission Defaults
MISSION_DEFAULTS__PRIORITY=MEDIUM
MISSION_DEFAULTS__RISK_LEVEL=LOW
MISSION_DEFAULTS__MAX_LOOP_ITERATIONS=10

# CORS: list only trusted frontend origins; browser access is limited to GET/POST.
BRAIN_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
BRAIN_AI_MODEL=gemini-3.5-flash-lite
# Set BRAIN_AI_API_KEY outside the repository; never commit a real key.
BRAIN_GITHUB_OWNER=
BRAIN_CONTROL_REPOSITORY=
# Configure BRAIN_GITHUB_TOKEN only in your private environment or secret store.
# Use a long random secret (at least 24 characters); never commit a real value.
BRAIN_CONTROL_API_KEY=

# Internal browser worker. Keep the allowlist as narrow as each task allows.
# Example for ChatGPT: chatgpt.com,*.chatgpt.com,openai.com,*.openai.com
BRAIN_BROWSER_ALLOWED_DOMAINS=
# Comma-separated exact hosts or subdomain rules; navigation to these origins requires owner approval.
BRAIN_BROWSER_SENSITIVE_DOMAINS=
BRAIN_BROWSER_PROFILE_DIR=./workspace/browser-profile
BRAIN_BROWSER_HEADLESS=true
# Optional: set only when the selected host has a compatible installed Chromium binary.
BRAIN_BROWSER_EXECUTABLE_PATH=
